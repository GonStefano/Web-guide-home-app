.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Sistema operativo ────────────────────────────────────────────
